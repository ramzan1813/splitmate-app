# SplitMate web frontend for local testing: static Expo web export served by nginx.
# EXPO_PUBLIC_* values are inlined at build time, so the relay URL is a build arg.
# It is the URL the *browser* uses, so it must be reachable from the host (localhost), not a compose service name.
FROM node:24-bookworm-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY vendor ./vendor
RUN npm ci --no-audit --no-fund

COPY . .

ARG EXPO_PUBLIC_RELAY_URL=http://localhost:8787
ENV EXPO_PUBLIC_RELAY_URL=$EXPO_PUBLIC_RELAY_URL \
    EXPO_NO_TELEMETRY=1 \
    CI=1

RUN npx expo export --platform web --output-dir dist

FROM nginx:1.29-alpine

COPY docker/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
