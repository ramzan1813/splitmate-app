# Loaded by `npm test`. Points the app's default relay at a closed local port so tests can never
# reach the production relay (the legacy SyncManager poll in src/data/sync.ts would otherwise connect to it).
# The legacy SyncManager also keeps reconnect timers alive, so `npm test` uses --test-force-exit.
EXPO_PUBLIC_RELAY_URL=ws://127.0.0.1:9/ws
